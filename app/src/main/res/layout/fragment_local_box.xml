<?xml version="1.0" encoding="utf-8"?>

<!--Layout for Category Fragment - shows the RecyclerView-->

<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">




    <data>
        <variable
            name="speedSeekBarViewModel"
            type="com.petertieu.android.localbox.SpeedSeekBarViewModel"/>
    </data>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">


        <LinearLayout
            android:id="@+id/linearLayout"
            android:layout_width="match_parent"
            android:layout_height="75dp"
            android:orientation="horizontal">


            <TextView
                android:id="@+id/english_text"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:gravity="center"
                android:textSize="50sp"/>


            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="3"
>


                <TextView
                    android:id="@+id/language_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="45sp"
                    android:gravity="center"/>


                <TextView
                    android:id="@+id/pronounciation_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="15dp"
                    android:layout_marginLeft="7dp"
                    android:gravity="center_vertical"/>

            </LinearLayout>


        </LinearLayout>


        <android.support.v7.widget.RecyclerView
            android:id="@+id/recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"/>





        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal">


            <!--Layout for Speed SeekBar-->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{String.format(@string/playback_speed, speedSeekBarViewModel.getCurrentSpeedValue)}"/>

            <TextView
                android:id="@+id/speed_seek_bar_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/normal"/>
        </LinearLayout>






        <SeekBar
            android:id="@+id/speed_seek_bar"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:progress="@{speedSeekBarViewModel.getCurrentSpeedPercentage}"
            android:onProgressChanged="@{speedSeekBarViewModel.setSpeedValue}"/>





    </LinearLayout>


</layout>